# Sample version 2026/11/15 confirmed running

# n8n version - get the version number of the latest stable release from https://github.com/n8n-io/n8n/releases
N8N_VERSION=2.47.7

# Sandbox service version - the API, runner, and sandbox images share one release.
# Get the number of the latest stable "service" release (not a staging prerelease) from https://github.com/n8n-io/n8n-sandbox-service/releases
N8N_SANDBOX_VERSION=1.15.0

# n8n task runner authentication. Use a random secret you generate.
N8N_RUNNERS_AUTH_TOKEN=   # runner-auth-token 

# Sandbox service secrets — pick your own values
SANDBOX_API_KEYS=   # api-key 
SANDBOX_RUNNER_REGISTRATION_TOKEN=   # registration-token
SANDBOX_API_RUNNER_REGISTRATION_TOKEN=   # registration-token
SANDBOX_RUNNER_API_KEYS=   # runner-key 

# Must match a value in SANDBOX_API_KEYS above — this is how n8n authenticates to the sandbox
N8N_SANDBOX_SERVICE_API_KEY=   # api-key

# Point n8n at the sandbox API using the same variables as the bundled sandbox
N8N_INSTANCE_AI_SANDBOX_ENABLED=true
N8N_INSTANCE_AI_SANDBOX_PROVIDER=n8n-sandbox
N8N_INSTANCE_AI_SANDBOX_API_URL=http://sandbox-api:8080
N8N_SANDBOX_SERVICE_URL=http://sandbox-api:8080
SANDBOX_API_RUNNER_API_KEY=   # runner-key

# Use a local or custom OpenAI-compatible endpoint
N8N_INSTANCE_AI_MODEL_URL=http://192.168.3.100:11434/v1
N8N_INSTANCE_AI_MODEL_API_KEY=ollama
N8N_INSTANCE_AI_MODEL=ukisai/Swift-1.5-Qwen3.8-27B-GSQ-RCO-IQ3_S:latest

# Web search
N8N_INSTANCE_AI_SEARXNG_URL=http://searxng-core:8081

# General values
N8N_DATA_PATH=/mnt/workspace/docker/docker-data/n8n-data
N8N_FILES_PATH=/mnt/workspace/apps/n8n-files
GENERIC_TIMEZONE=Asia/Manila
TZ=Asia/Manila